# Copy to .env and fill in. .env is gitignored; this file is committed,
# so it must never contain a real credential.

# ---- the single environment switch -----------------------------------
APP_ENV=dev                       # dev | staging | main
SYSTEM_ACTOR=system@costhub

# ---- Postgres --------------------------------------------------------
# dev: a Neon project. staging/main: RDS, supplied by Terraform.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Neon also gives a pooled endpoint; use it for the API, not for migrations.
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require"

# ---- access control --------------------------------------------------
ALLOWED_EMAIL_DOMAIN=chryselys.com

# ---- auth (from `terraform output` once deployed) --------------------
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_REGION=us-east-1

# ---- dev-only: accounts to ingest from -------------------------------
# In deployment this comes from the cloud_connections table instead.
# profile = a local AWS CLI profile name.
COST_ACCOUNTS=[{"provider":"aws","account_id":"self","name":"personal","profile":"default"}]
