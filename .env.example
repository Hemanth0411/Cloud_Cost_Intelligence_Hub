# Copy to .env and fill in. .env is gitignored; this file is committed,
# so it must never contain a real credential.

# ---- the single environment switch -----------------------------------
APP_ENV=dev                       # dev | staging | main
SYSTEM_ACTOR=system@costhub.internal

# ---- Postgres --------------------------------------------------------
# dev: a Neon project. staging/main: RDS, supplied by Terraform.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Neon also gives a pooled endpoint. NOTE: not read by config.py --
# kept here only so the value is to hand; set DATABASE_URL to it if
# you want the API to use the pooler.
# DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require"

# ---- access control --------------------------------------------------
ALLOWED_EMAIL_DOMAIN=chryselys.com

# Accept the X-Dev-User header instead of a real JWT, so the
# frontend can be built before Cognito exists. Requires APP_ENV=dev
# and no pool configured as well. Terraform NEVER sets this, so no
# deployed environment can reach the bypass.
ALLOW_DEV_AUTH=true

# ---- auth (from `terraform output` once deployed) --------------------
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_REGION=us-east-1

# ---- dev-only: accounts to ingest from -------------------------------
# In deployment this comes from the cloud_connections table instead.
# profile = a local AWS CLI profile name.
COST_ACCOUNTS=[{"provider":"aws","account_id":"self","name":"personal","profile":"default"}]

# Seeded as the first superadmin by `python -m costhub.migrate`. Without
# it a fresh environment has nobody who can invite anyone -- migrate
# prints a warning saying exactly that. Terraform creates the matching
# Cognito user; BOTH halves are required.
SUPERADMIN_EMAIL=you@chryselys.com

# Sender for alert email and login OTPs. Must be an SES-verified identity.
SES_SENDER_EMAIL=you@chryselys.com

# Comma-separated browser origins allowed to call the API. Unset means no
# cross-origin access (it does NOT fall back to a wildcard).
CORS_ORIGINS=
