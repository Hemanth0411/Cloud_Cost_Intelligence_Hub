# Render intermediates: regenerate with `npm run render` and
# `bash tools/contact-sheet.sh`. The finished film is the deliverable,
# so it is the one exception.
out/*
!out/costhub.mp4
node_modules/

# The Kokoro voice model (325 MB) and its venv. tools/make-audio.py needs
# only numpy + soundfile; see README.
tts/venv/
tts/*.onnx
tts/*.bin
tts/*.log

# Intermediates. bed.wav is the finished mix the video plays; vo.wav is
# kept because regenerating it needs the 325 MB Kokoro model.
public/audio/bed-raw.wav
public/audio/mix-raw.wav

# Screenshots are captured from a running dev server, not committed.
public/shots/
