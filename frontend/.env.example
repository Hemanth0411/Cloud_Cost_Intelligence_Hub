# Frontend configuration. Copy to .env.local, or let
# `./do.sh outputs dev` write that file for you from the Terraform
# outputs (which is the only way to be sure the values match the stack
# that is actually deployed).
#
# NOTHING HERE IS A SECRET. Next inlines every NEXT_PUBLIC_ variable
# into the client bundle at build time, so all of these are readable by
# anyone who loads the page. A Cognito pool id and a public app client
# id are designed for that. Never put a client secret, an AWS key or a
# token in this file.
#
# These CANNOT be set from Terraform. Putting them in
# aws_amplify_app.environment_variables closes a dependency cycle --
# Amplify's domain is already an input to the Cognito callback URLs and
# the Lambda CORS origins -- and terraform rejects the plan. For an
# Amplify build they are set in the Amplify console instead, and
# terraform/amplify.tf has a lifecycle block so an apply does not delete
# them.

# Mock mode is the DEFAULT, and only the exact string "false" turns it
# off. A missing or misspelled value falls back to mock rather than to
# an app full of failed requests. The app also stays on mock if any of
# the three values below are empty -- see src/lib/config.ts.
NEXT_PUBLIC_USE_MOCK=true

# Trailing slash optional; it is stripped.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Hostname only, no scheme: costhub-dev-<account>.auth.<region>.amazoncognito.com
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_AWS_REGION=us-east-1
