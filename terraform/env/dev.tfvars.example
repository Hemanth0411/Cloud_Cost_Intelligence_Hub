# Copy to dev.tfvars and fill in. *.tfvars is gitignored -- because
# amplify_basic_auth_password belongs in it -- so this template is the
# only version in the repo and must never contain a real secret.
#
# ONE FILE PER ENVIRONMENT, all three copies of this: dev.tfvars,
# staging.tfvars, main.tfvars. `./do.sh <cmd> <env>` refuses to run if
# the file for that environment is missing, so a fresh clone needs all
# three before `up main` will work.
#
# aws_region and name_prefix are set once in variables.tf; name_prefix
# is suffixed with the workspace automatically.

# The account this environment deploys into. Terraform refuses to run if
# the active credentials resolve to anything else -- run
# `aws sts get-caller-identity` and paste the Account value here.
aws_account_id = "000000000000"

superadmin_email            = "you@chryselys.com"
ses_sender_email            = "you@chryselys.com"   # must be SES-verified
amplify_basic_auth_password = "CHANGE-ME"

db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
log_retention_days   = 3
budget_limit_usd     = 80

# Whether http://localhost:5173 is an allowed CORS origin on the API.
# Leave true while the frontend is being built; set FALSE in
# main.tfvars, where a developer laptop has no business being an
# allowed origin with allow_credentials = true.
allow_local_frontend = true

# account_id "self" = the deploy account, read with the Lambda's own role.
data_source_accounts = [
  { account_id = "self", name = "personal" },

  # Another account needs a CostHubCostReader role created there first;
  # see docs/11-configuration.md.
  # { account_id  = "111111111111"
  #   name        = "other"
  #   role_arn    = "arn:aws:iam::111111111111:role/CostHubCostReader"
  #   external_id = "costhub-CHANGE-ME" },
]

# ---------------------------------------------------------------- demo users
#
# Cognito password sign-in is the default path (/login). These are the
# two accounts and their passwords, recorded here because this file is
# GITIGNORED -- the repo is public, so a password committed to docs/
# would be a working credential for a live deployment on the internet.
#
# Terraform does NOT set these. Cognito stores only a hash and has no
# API that returns a password, so they cannot be read back from the
# pool; they exist only because someone set them. To set or reset:
#
#   aws cognito-idp admin-set-user-password #     --user-pool-id <your pool id, from ./do.sh outputs dev> #     --username <email> --password '<password>' --permanent #     --region us-east-1
#
# --permanent is not optional: without it the user lands in
# FORCE_CHANGE_PASSWORD, InitiateAuth returns a challenge instead of
# tokens, and the login form can only tell them to find an admin.
#
#   you@chryselys.com             <set one>    (superadmin)
#   admin@chryselys.com           <set one>    (superadmin -- shared)
#
# Both are superadmin in the users table, so both see every account and
# bypass the grant predicate. For a demo that shows RBAC narrowing, you
# want a THIRD user with role 'user' and one grant.
