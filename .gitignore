# secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# terraform
.terraform/
# .terraform.lock.hcl is deliberately NOT ignored. It is the only thing
# pinning provider versions, and every provider-specific claim in docs/
# (which Cognito resources exist, what ses:FromAddress means) is true of
# aws 5.100.0 and not guaranteed of anything else.
*.tfstate
*.tfstate.*
terraform.tfstate.d/
crash.log
*.tfvars
!*.tfvars.example

# backups (teardown writes here; keep them local)
backups/

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# node / frontend
node_modules/
dist/
.vite/

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# build artifacts
dist/
